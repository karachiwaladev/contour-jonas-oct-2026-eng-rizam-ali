{
  "permissions": {
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r -f:*)",
      "Bash(rm --recursive --force:*)",
      "PowerShell(Remove-Item -Recurse -Force:*)",
      "PowerShell(Remove-Item -Force -Recurse:*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push --force-with-lease:*)",
      "PowerShell(git push -f:*)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",
      "PowerShell(iwr * | iex)",
      "PowerShell(irm * | iex)",
      "PowerShell(Invoke-WebRequest * | Invoke-Expression)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(cat .env:*)",
      "Bash(cat **/.env:*)",
      "PowerShell(Get-Content .env:*)",
      "PowerShell(Get-Content **/.env:*)",
      "PowerShell(type .env:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\block-dangerous.ps1\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\log-prompts.ps1\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "& \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\sync-to-github.ps1\"",
            "timeout": 120,
            "statusMessage": "Syncing to GitHub..."
          }
        ]
      }
    ]
  }
}
